DATABASE_URL="postgresql://crm:crm@localhost:5433/crm_magico?schema=public"
SESSION_SECRET="cambiar-por-un-valor-aleatorio-largo"
ENCRYPTION_KEY="base64-de-32-bytes (openssl rand -base64 32)"
APP_URL="http://localhost:3000"
# IA: proveedor que usan las funciones de IA (anthropic, groq o deepseek). Sin AI_PROVIDER se usa anthropic.
# AI_MODEL es opcional: cambia el modelo por defecto del proveedor
# (claude-opus-5-5 / openai/gpt-oss-120b / deepseek-flash; en DeepSeek también deepseek-v4-pro).
AI_PROVIDER="anthropic"
AI_MODEL=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
UPLOAD_DIR="./storage/uploads"

# Email (opcional). Sin SMTP los emails solo quedan registrados en el sistema.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

CRON_SECRET="cambiar"

# Archivos en Cloudflare R2 (opcional). Sin estas variables se guardan en UPLOAD_DIR.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Solo para usar otro servicio compatible con S3 (por ejemplo, pruebas locales):
# R2_ENDPOINT="http://localhost:9000"
